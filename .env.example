NODE_ENV=development
PORT=3000

# Orígenes del frontend (coma-separados). Si se omite, acepta cualquier Origin.
# CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Railway: no uses estas claves. En el servicio del API define
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# (Postgres es el nombre del servicio de la base; cámbialo si se llama distinto).
# Local: localhost | Docker (misma red): postgres_database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=postgres

# Solo desarrollo. En producción usar migraciones.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT (mínimo 16 caracteres)
JWT_SECRET=cambiar-este-secreto-jwt
JWT_EXPIRES_IN=8h

# Fotos de asistencia (local por ahora; TODO: S3)
# UPLOADS_DIR=uploads
