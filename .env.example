NODE_ENV=development
PORT=3000

# Orígenes del frontend (coma-separados). Si se omite, acepta cualquier Origin.
# CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# URLs del API (Swagger muestra ambas en /api/docs → Servers)
# PUBLIC_URL=https://befcobackend-production-de41.up.railway.app
# PRODUCTION_URL=https://befcobackend-production-de41.up.railway.app

# Cambio de base de datos en desarrollo:
#   DB_TARGET=local   → DB_* (Postgres local / Docker)
#   DB_TARGET=railway → RAILWAY_DATABASE_URL
# Atajos: npm run start:dev:local | npm run start:dev:railway
DB_TARGET=local

# URL pública de Postgres en Railway (no uses *.railway.internal desde tu PC).
# En el deploy de Railway el API sigue usando DATABASE_URL=${{Postgres.DATABASE_URL}}.
RAILWAY_DATABASE_URL=

# Local: localhost | Docker (misma red): postgres_database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=postgres

# Solo desarrollo local. En Railway/remoto hace falta además DB_SYNCHRONIZE_REMOTE=true.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT (mínimo 16 caracteres)
JWT_SECRET=cambiar-este-secreto-jwt
JWT_EXPIRES_IN=8h

# Fotos de asistencia (local por ahora; TODO: S3)
# UPLOADS_DIR=uploads
